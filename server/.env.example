# ==============================================================================
# File: server/.env.example
# Purpose: Template for server environment variables.
# DO NOT put real credentials or secrets in this example file.
# ==============================================================================

# Google Gemini API Key (Required)
GEMINI_API_KEY=your_gemini_api_key_here

# Gemini Model Identifier (Default: gemini-3.5-flash-lite)
GEMINI_MODEL=gemini-3.5-flash-lite

# Tavily API Key for Web Search (Optional/Required for research tool)
TAVILY_API_KEY=your_tavily_api_key_here

# Google OAuth Configuration (Required for Google OAuth connection)
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
GOOGLE_REDIRECT_URI=http://localhost:8000/api/auth/google/callback

# Google Calendar Timezone Configuration (Default: Asia/Kolkata)
GOOGLE_CALENDAR_TIMEZONE=Asia/Kolkata
